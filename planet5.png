<script>
(function () {
  if (window.__cleanpngAdsLoaderScheduled) return;
  window.__cleanpngAdsLoaderScheduled = true;

  function loadAds() {
    if (window.__cleanpngAdsLoaded) return;
    window.__cleanpngAdsLoaded = true;
    var script = document.createElement('script');
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4140692434942764';
    document.head.appendChild(script);
  }

  function scheduleAds() {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadAds, { timeout: 2500 });
      return;
    }
    window.setTimeout(loadAds, 1800);
  }

  if (document.readyState === 'complete') {
    scheduleAds();
  } else {
    window.addEventListener('load', scheduleAds, { once: true });
  }
	})();
	</script>
	<script>
(function () {
  if (window.__cleanpngInlineAdsPushed) return;
  window.__cleanpngInlineAdsPushed = true;

  function pushInlineAds() {
    var slots = document.querySelectorAll('.cleanpng-adsense-test-slot ins.adsbygoogle');
    for (var i = 0; i < slots.length; i += 1) {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pushInlineAds, { once: true });
    return;
  }
  pushInlineAds();
})();
</script>

		<script>
(() => {
  window.__cleanpngDedicatedViewBeacon = 1;
  const urlId = "hom2bt";
  if (!urlId || typeof navigator === "undefined") return;

  let visibleMs = 0;
  let lastTick = Date.now();
  let scrolled = window.scrollY >= 80 ? 1 : 0;
  let mouseMoved = 0;
  let sent = 0;

  const addVisibleTime = () => {
    const now = Date.now();
    if (!document.hidden) visibleMs += now - lastTick;
    lastTick = now;
  };

  const send = () => {
    if (sent) return;
    addVisibleTime();
    if (visibleMs < 3000 || (!scrolled && !mouseMoved)) return;
    sent = 1;
    const payload = {
      type: "pdt_view",
      url_id: urlId,
      path: window.location.pathname,
      visible_ms: visibleMs,
      scrolled: scrolled,
      mouse_moved: mouseMoved
    };
    const trackGa = () => {
      if (typeof window.__cleanpngTrackBeaconView === "function") window.__cleanpngTrackBeaconView(payload);
    };
    const body = JSON.stringify(payload);
    if (navigator.sendBeacon) {
      if (navigator.sendBeacon("/stat-beacon/", new Blob([body], { type: "application/json" }))) {
        trackGa();
        return;
      }
    }
    trackGa();
    fetch("/stat-beacon/", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: body,
      keepalive: true,
      credentials: "same-origin"
    }).catch(() => {});
  };

  window.addEventListener("scroll", () => {
    if (window.scrollY >= 80) scrolled = 1;
    send();
  }, { passive: true });

  window.addEventListener("mousemove", () => {
    mouseMoved = 1;
    send();
  }, { passive: true });

  document.addEventListener("visibilitychange", () => {
    addVisibleTime();
    send();
  });

  setInterval(send, 500);
})();
</script>

