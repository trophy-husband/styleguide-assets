<script>
(function () {
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){dataLayer.push(arguments);};

  function trackBeaconView(payload) {
    try {
      if (window.__cleanpngGaViewTracked) return;
      var path = window.location.pathname || '/';
      if (/^\/view(\/|$)/i.test(path) || /^\/(about|privacy|terms|policy|dmca|contact|service)(\.html)?\/?$/i.test(path)) return;
      var viewPath = ('/view' + path).replace(/\/{2,}/g, '/');
      var viewUrl = window.location.origin + viewPath;
      loadGa();
      window.__cleanpngGaViewTracked = 1;
      window.gtag('event', 'page_view', {
        page_location: viewUrl,
        page_title: document.title || '',
        cleanpng_view_type: payload && payload.type ? payload.type : '',
        cleanpng_url_id: payload && payload.url_id ? payload.url_id : '',
        cleanpng_tag_id: payload && payload.tag_id ? payload.tag_id : ''
      });
    } catch (e) {}
  }

  function startAutoViewTracking() {
    if (window.__cleanpngAutoViewTrackingStarted) return;
    window.__cleanpngAutoViewTrackingStarted = 1;
    var visibleMs = 0;
    var lastTick = Date.now();
    var scrolled = window.scrollY >= 80 ? 1 : 0;
    var interacted = 0;
    function addVisibleTime() {
      var now = Date.now();
      if (!document.hidden) visibleMs += now - lastTick;
      lastTick = now;
    }
    function sendAutoView() {
      if (window.__cleanpngGaViewTracked || window.__cleanpngDedicatedViewBeacon) return;
      addVisibleTime();
      if (visibleMs < 3000 || (!scrolled && !interacted)) return;
      trackBeaconView({
        type: 'site_view',
        path: window.location.pathname,
        visible_ms: visibleMs,
        scrolled: scrolled,
        interacted: interacted
      });
    }
    window.addEventListener('scroll', function(){ if (window.scrollY >= 80) scrolled = 1; sendAutoView(); }, { passive: true });
    window.addEventListener('mousemove', function(){ interacted = 1; sendAutoView(); }, { passive: true });
    window.addEventListener('touchstart', function(){ interacted = 1; sendAutoView(); }, { passive: true });
    document.addEventListener('click', function(){ interacted = 1; sendAutoView(); }, true);
    document.addEventListener('visibilitychange', function(){ addVisibleTime(); sendAutoView(); });
    window.setInterval(sendAutoView, 500);
  }

  function loadGa() {
    if (window.__cleanpngGaLoaded) return;
    window.__cleanpngGaLoaded = true;
    var script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-WR5JC9XF6P';
    document.head.appendChild(script);
    window.gtag('js', new Date());
    window.gtag('config', 'G-WR5JC9XF6P');
  }

  function scheduleGa() {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadGa, { timeout: 3000 });
      return;
    }
    window.setTimeout(loadGa, 2200);
  }

  if (document.readyState === 'complete') {
    scheduleGa();
  } else {
    window.addEventListener('load', scheduleGa, { once: true });
  }

  window.__cleanpngTrackBeaconView = trackBeaconView;
  startAutoViewTracking();
})();
</script>


